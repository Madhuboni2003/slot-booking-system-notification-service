<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your InterviewCall Account Invitation</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif; color:#111827;">
  <table
    role="presentation"
    cellpadding="0"
    cellspacing="0"
    border="0"
    width="100%"
    style="width:100%; margin:0; padding:0; background-color:#f4f7fb;"
  >
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table
          role="presentation"
          cellpadding="0"
          cellspacing="0"
          border="0"
          width="100%"
          style="width:100%; max-width:620px; background-color:#ffffff; border:1px solid #e5e7eb; border-radius:14px;"
        >
          <tr>
            <td style="padding:30px 30px 26px 30px;">

              <h1 style="margin:0 0 22px 0; font-size:24px; line-height:32px; font-weight:700; color:#2563eb;">
                You're Invited to InterviewCall
              </h1>

              <p style="margin:0 0 16px 0; font-size:15px; line-height:24px; color:#111827;">
                Hi {{fullName}},
              </p>

              <p style="margin:0 0 16px 0; font-size:15px; line-height:24px; color:#111827;">
                An administrator has created an InterviewCall account for you.
                Please set your password to activate your account and get started.
              </p>

              <p style="margin:0 0 24px 0; font-size:15px; line-height:24px; color:#111827;">
                Click the button below to choose your password.
              </p>

              <table
                role="presentation"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="margin:0 0 26px 0;"
              >
                <tr>
                  <td align="center" bgcolor="#2563eb" style="border-radius:8px;">
                    <a
                      href="{{activationUrl}}"
                      target="_blank"
                      style="display:inline-block; padding:14px 22px; font-size:15px; line-height:20px; font-weight:700; color:#ffffff; text-decoration:none; background-color:#2563eb; border-radius:8px;"
                    >
                      Set Your Password
                    </a>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 8px 0; font-size:13px; line-height:20px; color:#475569;">
                This invitation link expires in 24 hours.
                Please set your password before it expires.
              </p>

              <p style="margin:20px 0 2px 0; font-size:13px; line-height:20px; color:#475569;">
                If the button does not work, copy and open this link:
              </p>

              <p style="margin:0 0 28px 0; font-size:13px; line-height:20px; color:#2563eb; word-break:break-all;">
                <a
                  href="{{activationUrl}}"
                  target="_blank"
                  style="color:#2563eb; text-decoration:underline;"
                >
                  {{activationUrl}}
                </a>
              </p>

              <p style="margin:0; font-size:15px; line-height:24px; color:#111827;">
                Regards,<br />
                InterviewCall Team
              </p>

            </td>
          </tr>
        </table>

        <table
          role="presentation"
          cellpadding="0"
          cellspacing="0"
          border="0"
          width="100%"
          style="width:100%; max-width:620px;"
        >
          <tr>
            <td align="center" style="padding:16px 8px 0 8px;">
              <p style="margin:0; font-size:12px; line-height:18px; color:#64748b;">
                This is an automated account invitation email from InterviewCall.
              </p>
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>